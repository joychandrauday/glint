# ==========================================
# Glint - Environment Configuration Template
# ==========================================
# Copy this file to .env before starting services:
#   cp .env.example .env

# ------------------------------------------
# Supabase Backend & Database Configuration
# ------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection URLs (used for migrations and admin tools)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------
# Multi-LLM API Keys (AI Gateway Cascade)
# ------------------------------------------
# Primary Provider (Ultra-fast inference): Groq (llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Fallback 1: Google Gemini (gemini-2.5-flash)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ------------------------------------------
# AI Gateway & Server Settings
# ------------------------------------------
PORT=8787
ADMIN_SECRET_KEY=glint_admin_super_secret_token_change_in_production

# ------------------------------------------
# Client / Frontend Environment Variables (Vite)
# ------------------------------------------
VITE_GATEWAY_URL=http://localhost:8787
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------
# SMTP Email Notifications (Optional / Admin)
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASSWORD=app_specific_password_here
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME="Glint System"
EMAIL_FROM=alerts@example.com
