# Glint Self-Hosted Environment Configuration
# Copy this file to .env before running `docker compose up -d`

# Database Configuration
POSTGRES_USER=glint
POSTGRES_PASSWORD=glint_secret_password_change_me
POSTGRES_DB=glint_db
POSTGRES_PORT=5432

# Ports
GATEWAY_PORT=3001
ADMIN_PORT=3000

# Backend / Gateway Options
DEFAULT_DAILY_QUOTA=100
PRIMARY_PROVIDER=groq
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# Optional Central AI Keys (If self-hosting an AI pool for your team)
# Users can also use their own personal BYOK keys directly from the desktop client at $0 server cost!
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
