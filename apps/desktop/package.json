{
  "name": "@glint/desktop",
  "version": "0.2.10",
  "description": "Glint: Lightweight, context-aware command-line cheatsheet overlay & AI assistant",
  "author": "Glint Team <dev@glint.dev>",
  "homepage": "https://github.com/joychandrauday/glint",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node electron/launcher.cjs",
    "dev": "node electron/launcher.cjs",
    "dev:web": "vite",
    "desktop": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron --ozone-platform=x11 --enable-transparent-visuals --no-sandbox .",
    "build": "tsc && vite build",
    "package:dir": "npm run build && electron-builder --dir",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "package:win": "npm run build && electron-builder --windows nsis portable --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.glint.desktop",
    "productName": "Glint",
    "executableName": "glint",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Glint Contributors",
    "directories": {
      "output": "release"
    },
    "electronVersion": "45.2.2",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "deb": {
      "afterInstall": "scripts/deb-after-install.sh",
      "afterRemove": "scripts/deb-after-remove.sh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development;Utility;",
      "icon": "assets/icon.png",
      "maintainer": "Glint Team <dev@glint.dev>",
      "synopsis": "Lightweight, context-aware command-line cheatsheet overlay & AI assistant",
      "executableArgs": [
        "--ozone-platform=x11",
        "--enable-transparent-visuals",
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-gpu",
        "--disable-features=VaapiVideoDecoder,VaapiVideoEncoder,VaapiIgnoreDriverChecks",
        "--disable-accelerated-video-decode",
        "--disable-accelerated-video-encode",
        "--disable-logging",
        "--log-level=3",
        "--v=-1"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "joychandrauday",
        "repo": "glint"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glint",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@glint/db": "*",
    "@glint/shared": "*",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^9.5.1"
  }
}
